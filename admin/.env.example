PORT=8080
HOST=localhost
LOG_LEVEL=info
# Optional: override the URL used to test internet connectivity.
# Defaults to https://1.1.1.1/cdn-cgi/trace with fallbacks to hosts the app
# already contacts. Leave unset to use the defaults.
# INTERNET_STATUS_TEST_URL=https://1.1.1.1/cdn-cgi/trace
APP_KEY=some_random_key
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_DATABASE=nomad
DB_PASSWORD=password
DB_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Redis logical database index (0-15). Defaults to 0 if unset.
# Set this when sharing a Redis instance across services to avoid key collisions.
# REDIS_DB=0
# Storage path for NOMAD content (ZIM files, maps, etc.)
# On Windows dev, use an absolute path like: C:/nomad-storage
# On Linux production, use: /opt/project-nomad/storage
NOMAD_STORAGE_PATH=/opt/project-nomad/storage
# Creator Packs (gated content downloads). Official release builds inject
# CREATOR_PACKS_APP_KEY at build time; leave unset for a build that can't install
# packs. CREATOR_PACKS_WORKER_BASE overrides the entitlement Worker origin.
# CREATOR_PACKS_APP_KEY=
# CREATOR_PACKS_WORKER_BASE=https://nomad-packs-worker.chris-556.workers.dev
# Optional offline routing packs. The catalog is managed by the administrator.
# MAP_PACKS_PATH=/app/storage/map-packs
# MAP_PACK_CATALOG_PATH=/app/resources/map-packs/catalog.json
# MAP_ROUTER_URL=http://map-router:8082
# Enable only for a deliberately configured trusted local package mirror.
# MAP_PACK_ALLOW_LOCAL_DOWNLOADS=false
# Optional offline route preparation from public OSM sources.
# MAP_REGIONS_PATH=/app/storage/map-regions
# MAP_REGIONS_CATALOG_PATH=/app/resources/map-regions/catalog.json
# MAP_REGION_BUILDER_URL=http://map-builder:8083
# Optional preparation URL override. Fresh deployments use the same routing builder.
# MAP_REGION_PREPARATION_BUILDER_URL=http://map-builder:8083
# Optional read-only mounted directory on the physical drive backing a virtual data volume.
# MAP_REGIONS_BACKING_DISK_PATH=/host-storage
# MAP_VISUAL_PATH=/app/storage/maps/pmtiles
